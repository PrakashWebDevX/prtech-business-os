# --- LLM providers (100% free tier — no OpenAI usage) ---
# Get a free key at https://build.nvidia.com (NIM, OpenAI-compatible API)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL and NVIDIA_EMBED_MODEL are both optional — if unset (or if
# the model you set is no longer live), tools/llm.py auto-detects a working
# model via NIM's /v1/models endpoint. Leave commented out unless you want
# to force a specific model.
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Web search (used by the Research agent) ---
# Free tier: 1,000 searches/month, no card required.
# Get a key at https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Outreach (optional, only needed once Outreach agent is enabled) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password-here

# --- App config ---
ENV=development
MAX_OUTREACH_PER_HOUR=20
BROWSER_HEADLESS=true
LOG_LEVEL=INFO
